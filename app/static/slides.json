{
  "_meta": {
    "description": "Editable slide content for the Härdad build-journal presentation. Each slide is a flat list of typed blocks. Reordering a slide only needs a JSON edit — no JSX touch. Recognised block types: eyebrow, title, lede, body, pills, stats, table, arch, callout, sc-layers.",
    "blockTypes": {
      "eyebrow":   { "text": "small uppercase label above the title" },
      "title":     { "text": "H2 title (H1 is rendered for type='title-hero')", "hero": "optional boolean — render as H1" },
      "lede":      { "text": "larger intro paragraph", "html": "optional HTML override" },
      "body":      { "text": "paragraph text", "html": "optional HTML override for inline <code>/<em>/<strong>" },
      "pills":     { "items": [{"text": "label", "variant": "ok|warn|(none)"}] },
      "stats":     { "items": [{"k": "eyebrow", "v": "big number", "d": "footer", "dClass": "optional 'neg'", "vSmall": "optional true"}] },
      "table":     { "headers": ["col labels"], "rows": [[{"text": "cell", "class": "good|bad|mono|(none)"}]], "maxWidth": "optional px" },
      "arch":      { "items": [{"tag": "node", "name": "...", "label": "...", "indent": 0}, {"tag": "arrow", "text": "..."}] },
      "callout":   { "text": "code block text" },
      "sc-layers": { "items": [{"level": "L1", "color": "err|l-c2|ok", "title": "...", "desc": "..."}] }
    }
  },

  "slides": [
    {
      "id": "00-demo",
      "label": "00 DEMO · Block cheatsheet",
      "blocks": [
        { "type": "eyebrow", "text": "DEMO · block cheatsheet (dev only)" },
        { "type": "title", "hero": true, "text": "Every block type, rendered once." },
        { "type": "lede", "html": "Each section below shows one <code>blockTypes</code> entry from <code>slides.json</code>. Delete this slide before shipping." },

        { "type": "eyebrow", "text": "eyebrow" },
        { "type": "body", "html": "<code>{ \"type\": \"eyebrow\", \"text\": \"...\" }</code> — small uppercase label above a title." },

        { "type": "eyebrow", "text": "title (hero + normal)" },
        { "type": "title", "hero": true, "text": "title · hero=true → H1" },
        { "type": "title", "text": "title · hero omitted → H2" },
        { "type": "body", "html": "<code>{ \"type\": \"title\", \"hero\": true, \"text\": \"...\" }</code> — set <code>hero</code> only on slide 01." },

        { "type": "eyebrow", "text": "lede" },
        { "type": "lede", "html": "lede · larger intro paragraph. Supports <code>text</code> or <code>html</code>." },

        { "type": "eyebrow", "text": "body" },
        { "type": "body", "html": "body · paragraph text, optional <code>html</code> for <em>inline</em> <strong>markup</strong>." },

        { "type": "eyebrow", "text": "pills" },
        { "type": "pills", "items": [
          { "text": "variant omitted (neutral)" },
          { "text": "variant: ok", "variant": "ok" },
          { "text": "variant: warn", "variant": "warn" }
        ]},

        { "type": "eyebrow", "text": "stats" },
