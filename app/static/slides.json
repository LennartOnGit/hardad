          { "k": "eyebrow (k)", "v": "big number (v)", "d": "footer (d)" },
          { "k": "dClass: neg", "v": "−42%", "d": "red footer", "dClass": "neg" },
          { "k": "vSmall: true", "v": "small value text", "d": "for longer strings", "vSmall": true }
        ]},

        { "type": "eyebrow", "text": "table" },
        { "type": "table",
          "headers": ["cell class", "example", "note"],
          "rows": [
            [ {"text":"(none)"},  {"text":"plain"},          {"text":"default body font"} ],
            [ {"text":"mono"},    {"text":"3.5.5-1","class":"mono"}, {"text":"monospace","class":"mono"} ],
