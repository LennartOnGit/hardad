            [ {"text":"bad"},     {"text":"✗ fail","class":"bad"},   {"text":"red","class":"bad"} ]
          ]
        },
        { "type": "body", "html": "Optional <code>maxWidth</code> (px number) constrains the table." },

        { "type": "eyebrow", "text": "arch" },
