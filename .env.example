# Required — your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Model to use for the tutor (default: claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-5

# Postgres connection string
DATABASE_URL=postgresql+psycopg://tutor:dev@localhost:5432/tutor

# Required — the admin user's access token. Create a user row is auto-seeded
# on startup with this token, is_admin=true, and no daily budget.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=REPLACE_ME

# How many recent (user, assistant) pairs to send to Anthropic per request (default: 50)
HISTORY_RETENTION_TURNS=50

# Sub-path the app is mounted under behind a reverse proxy (default: /docker_demo)
ROOT_PATH=/docker_demo

# Logging level (default: INFO)
LOG_LEVEL=INFO
